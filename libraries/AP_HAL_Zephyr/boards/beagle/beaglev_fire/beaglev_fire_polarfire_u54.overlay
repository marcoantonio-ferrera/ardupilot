/*
 * ArduPilot peripheral map for beaglev_fire/polarfire/u54.
 */

/ {
	chosen {
		/* shares wire with SERIAL0/MAVLink -- standalone board's normal wiring */
		zephyr,console = &uart2;
	};

	aliases {
		ardupilot-serial0 = &uart2;
		ardupilot-serial4 = &uart4;

		/* RCInput autodetects framing; SBUS is inverted and needs an external
		 * inverter since the MSS UART has no RX invert (iBUS is not). */
		ardupilot-rcinput = &uart3;

		ardupilot-gpio0 = &gpio0;
		ardupilot-gpio2 = &gpio2;

		ardupilot-i2c0 = &cape_i2c;

		ardupilot-spi1 = &spi1;

		ardupilot-pwm0 = &fabric_servo_pwm;

		ardupilot-esc-enable = &esc_enable_pin;

		sdhc0 = &sdhc_spi;
	};

	/* ROBOTICS cape fabric servo PWM, 8 ch in the FIC3 AXI window. */
	fabric_servo_pwm: servo-pwm@41000000 {
		compatible = "beaglev-fire,fabric-servo-pwm";
		reg = <0x41000000 0x20>;
		#pwm-cells = <2>;
		status = "okay";
	};

	/* fabric CoreI2C for IMU + baro (P9_19 SCL / P9_20 SDA), replacing MSS i2c0
	 * so the MSS AHB can stay at 150 MHz for USB; BCLK_DIV_8 gives ~390 kHz SCL. */
	cape_i2c: i2c@41600000 {
		compatible = "ardupilot,mpfs-corei2c";
		reg = <0x41600000 0x1000>;
		interrupt-parent = <&plic>;
		interrupts = <150 1>;        /* fabric F2M[32] -> PLIC 118+32 */
		clock-frequency = <400000>;  /* FAST -> BCLK_DIV_8 */
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";
	};

	esc_enable_keys: esc-enable-keys {
		compatible = "gpio-keys";
		esc_enable_pin: esc_enable_pin {
			gpios = <&gpio2 18 GPIO_ACTIVE_HIGH>;
			label = "ESC_ENABLE";
		};
	};
};

/* retired: IMU/baro moved to cape_i2c */
&i2c0 {
	status = "disabled";
};

&i2c1 {
	status = "disabled";
};

&gpio0 {
	status = "okay";
	ngpios = <14>;
};

&gpio1 {
	/* unused by ArduPilot and no Linux to hand it to in standalone mode,
	 * so left enabled with default ngpios */
	status = "okay";
};

&gpio2 {
	status = "okay";
	ngpios = <32>;

	vio_enable: vio_enable {
		gpio-hog;
		gpios = <30 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "VIO_ENABLE";
	};
};

&uart1 {
	status = "disabled";
};

/* MSS AHB is at its default 150 MHz (no divider shim), so clock-frequency
 * must match at 150 MHz for ns16550's baud latch calc. */
&uart2 {
	status = "okay";
	clock-frequency = <150000000>;
	current-speed = <115200>;
};

&uart3 {
	status = "okay";
	clock-frequency = <150000000>;
	current-speed = <115200>;
};

&uart4 {
	/* GPS, u-blox NEO-M8N; 9600 matches DEFAULT_SERIAL4_BAUD */
	status = "okay";
	clock-frequency = <150000000>;
	current-speed = <9600>;
};

&uart0 {
	status = "disabled";
};

&spi1 {
	/* ardupilot,mpfs-mss-spi, not upstream microchip,mpfs-spi: upstream has
	 * no GPIO CS handling, so cs-gpios below would be ignored. */
	compatible = "ardupilot,mpfs-mss-spi";
	status = "okay";
	clock-frequency = <150000000>;
	#address-cells = <1>;
	#size-cells = <0>;
	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;

	sdhc_spi: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		/* 1 MHz is conservative; bump once mount is known-good */
		spi-max-frequency = <1000000>;
		cd-gpios = <&gpio2 31 GPIO_ACTIVE_LOW>;
		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

/* Zephyr SRAM stays at the full 2 GiB ddr_cached_high window from
 * beaglev_fire_common.dtsi -- standalone FC owns all of DDR, so there's no
 * Linux reservation to bound the heap (the AMP variant shrinks this to
 * 128 MiB and adds the rpmsg/IHC nodes). */
